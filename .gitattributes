# Store text files with LF line endings in the repo, whatever OS or git
# settings a contributor uses. Git converts to the platform's native line
# endings on checkout, so Windows users still get CRLF in their editor.
* text=auto

# Binary files: never touch line endings.
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
