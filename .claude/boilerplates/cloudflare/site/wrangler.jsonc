{
  // Static site on Cloudflare. No server code: Cloudflare serves the files in ./public.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    // Serve public/404.html for unknown URLs
    "not_found_handling": "404-page"
  }
}
